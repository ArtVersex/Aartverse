# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env files (never commit real credentials)
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# unused raw source images left in project root (processed versions live in
# public/categories/ and public/) — not referenced by any app code
/painting.png
/sculpture.png
/mixed_media.png
/printmaking.png
/drawing.png
/logo.png

# credential files (defensive — these should never live inside the repo,
# but ignore them by name in case they are ever copied in by mistake)
hostinger.txt
client_secret*.json
*.apps.googleusercontent.com.json

# user-uploaded artwork images (runtime data, not source)
/public/uploads/*
!/public/uploads/.gitkeep

# leftover scratch/diagnostic files from earlier debugging sessions -- not
# part of the app, kept around locally but never meant to be committed
/_incoming_refresh_batch.tar.gz
/_to_delete/
