# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already listed in .gitignore.

# --- Database (existing) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth (from Google Cloud Console credentials JSON — do NOT commit the JSON file)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Base URL of this deployment. http://localhost:3000 in dev,
# https://aartverse.com in production.
AUTH_URL=http://localhost:3000
# Used to build absolute links inside transactional emails (verification,
# password reset). Keep in sync with AUTH_URL per environment.
APP_URL=http://localhost:3000

# --- Hostinger SMTP (transactional email) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@aartverse.com

# --- Remote image hosting (optional) ---
# When these are set, new artist-uploaded images (artwork feature images,
# profile/cover photos) are converted to WebP and pushed over FTP to the
# same Hostinger host that serves the site's existing catalogue images
# (public_html/images/...), so they are hosted and viewable the same way.
# When left unset, uploads fall back to this app's own local disk under
# public/uploads/ instead — fine for local dev, not for a serverless host.
#
# Never commit real FTP credentials. Get the exact remote directory and
# public base URL from Hostinger's hPanel (File Manager / FTP Accounts) —
# the remote dir is wherever public_html/images resolves to from that FTP
# account's own root, which is not always "/images".
IMAGE_FTP_HOST=
IMAGE_FTP_PORT=21
IMAGE_FTP_USER=
# If your FTP password contains a # (or other special characters), wrap it
# in single quotes, e.g. IMAGE_FTP_PASSWORD='my#pass123' -- otherwise Next.js's
# env loader silently truncates the value at the first unquoted '#', producing
# a wrong password with no warning (this bit us once -- see AUTH_SETUP.md §12).
IMAGE_FTP_PASSWORD=
IMAGE_FTP_SECURE=false
IMAGE_FTP_REMOTE_DIR=/images
IMAGE_PUBLIC_BASE_URL=https://springgreen-antelope-607895.hostingersite.com/images
